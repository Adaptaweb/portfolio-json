---
// 1200×630 card captured by scripts/generate-assets.mjs into public/og.png
import '@/styles/global.css'
import { basics } from '@/lib/cv'
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG · {basics.name}</title>
  </head>
  <body>
    <div class="og">
      <div class="profile">
        <img src={basics.image} alt="" width="200" height="200" />
        <p class="mono">Calama, Chile</p>
      </div>
      <div class="text">
        <p class="label">alejandro.tamayo</p>
        <h1>{basics.name}</h1>
        <p class="role">Full Stack Developer · Soporte Senior</p>
        <p class="mono">React · FastAPI · Flutter · PostgreSQL</p>
      </div>
    </div>
  </body>
</html>

<style>
  body {
    overflow: hidden;
  }
  .og {
    width: 1200px;
    height: 630px;
    display: flex;
    align-items: center;
    gap: 64px;
    padding: 72px;
    box-sizing: border-box;
  }
  .profile {
    flex: none;
    display: grid;
    justify-items: center;
    gap: 20px;
    padding: 40px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 32px;
  }
  img {
    max-width: none;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    border: 5px solid var(--accent);
  }
  .text {
    display: grid;
    gap: 18px;
  }
  .label {
    font-size: 22px;
  }
  h1 {
    font-size: 68px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .role {
    font-size: 30px;
    color: var(--muted);
  }
  .mono {
    font-size: 20px;
  }
</style>
