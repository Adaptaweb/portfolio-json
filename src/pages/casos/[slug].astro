---
import type { GetStaticPaths } from 'astro'
import Layout from '@/layouts/Layout.astro'
import Icon from '@/components/Icon.astro'
import DemoVideo from '@/components/DemoVideo.astro'
import WebPlaylist from '@/components/WebPlaylist.astro'
import Stage from '@/components/Stage.astro'
import Showcase from '@/components/Showcase.astro'
import { projects, formatRange, hasDetailPage, type Project } from '@/lib/cv'

export const getStaticPaths = (() => {
  const list = projects.filter(hasDetailPage)
  return list.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: list[(i + 1) % list.length] },
  }))
}) satisfies GetStaticPaths

interface Props {
  project: Project
  next: Project
}

const { project: p, next } = Astro.props
const screens = p.media?.filter((m) => !m.device) ?? []
const phones = p.media?.filter((m) => m.device === 'phone') ?? []
const tablets = p.media?.filter((m) => m.device === 'tablet') ?? []
const devices = [...phones, ...tablets]
const columns = p.architecture
  ? [
      { title: 'Clientes', nodes: p.architecture.clients },
      { title: 'Servicios', nodes: p.architecture.services },
      { title: 'Datos', nodes: p.architecture.data },
    ]
  : []
---

<Layout title={`${p.name} · Alejandro Tamayo`} description={p.description}>
  <article>
    <header>
      <a class="back" href="/#proyectos"><Icon name="arrow-left" size={16} /> Proyectos</a>
      <p class="label">{p.type} · {p.entity}</p>
      <h1 class="title" style={`view-transition-name: case-${p.slug}`}>{p.name}</h1>
      <p class="lead">{p.description}</p>
      <dl class="meta">
        <div><dt>Periodo</dt><dd>{formatRange(p.startDate, p.endDate)}</dd></div>
        <div><dt>Stack</dt><dd>{p.keywords.join(' · ')}</dd></div>
        {p.url && (
          <div>
            <dt>En producción</dt>
            <dd><a class="live-link" href={p.url} target="_blank" rel="noopener">{p.url.replace(/^https?:\/\//, '').replace(/\/$/, '')} <Icon name="arrow-up-right" size={14} /></a></dd>
          </div>
        )}
      </dl>
    </header>

    {
      (screens.length > 0 || devices.length > 0) && (
        <Showcase>
          {screens.length > 0 && (
            <Stage backdrop={screens[0].src}>
              <WebPlaylist clips={screens} app={p.name} />
            </Stage>
          )}
          {devices.length > 0 && (
            <Stage backdrop={devices[0].src}>
              <div class:list={['devices', { mixed: phones.length > 0 && tablets.length > 0 }]}>
                {phones.length > 0 && (
                  <div class="phones">
                    {phones.map((m) => (
                      <DemoVideo src={m.src} caption={m.caption} device="phone" />
                    ))}
                  </div>
                )}
                {tablets.map((m) => (
                  <DemoVideo src={m.src} caption={m.caption} device="tablet" />
                ))}
              </div>
            </Stage>
          )}
        </Showcase>
      )
    }

    {
      p.problem && (
        <section class="block">
          <h2 class="label">El problema</h2>
          <p class="big">{p.problem}</p>
        </section>
      )
    }

    {
      p.context && (
        <section class="block">
          <h2 class="label">Contexto</h2>
          <ul class="context">
            {p.context.map((c) => (
              <li class="card">{c}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      columns.length > 0 && (
        <section class="block">
          <h2 class="label">Arquitectura</h2>
          <div class="arch" role="img" aria-label="Clientes que llaman a la API FastAPI, que escribe en PostgreSQL; workers aislados para catálogo offline y BI.">
            {columns.map((col, i) => (
              <div class="col">
                <p class="mono">{col.title}</p>
                {col.nodes.map((n) => (
                  <div class:list={['node', { primary: n.primary }]}>
                    <strong>{n.name}</strong>
                    <span>{n.detail}</span>
                  </div>
                ))}
                {i < columns.length - 1 && (
                  <span class="link" aria-hidden="true">
                    <Icon name="arrow" size={22} />
                  </span>
                )}
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      p.decisions && (
        <section class="block">
          <h2 class="label">Decisiones</h2>
          <ol class="decisions">
            {p.decisions.map((d, i) => (
              <li class="reveal">
                <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                <h3>{d.title}</h3>
                <p>{d.text}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      p.results && (
        <section class="block">
          <h2 class="label">Resultado</h2>
          <ul class="results">
            {p.results.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </section>
      )
    }

    <a class="next card glow-card" href={`/casos/${next.slug}`}>
      <span class="mono">Siguiente</span>
      <span class="next-name">{next.name} <Icon name="arrow" size={24} /></span>
    </a>
  </article>
</Layout>

<style>
  article {
    display: grid;
    gap: 56px;
  }
  header {
    display: grid;
    gap: 16px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
    min-height: 40px;
    color: var(--muted);
    text-decoration: none;
    font-size: 15px;
  }
  .back:hover {
    color: var(--ink);
  }
  .lead {
    max-width: 820px;
    font-size: 18px;
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 8px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  dt {
    font: 12px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  dd {
    margin: 4px 0 0;
  }
  .live-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--accent);
    text-decoration: none;
  }
  .live-link:hover {
    color: var(--accent-hover);
  }
  .block {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 32px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  .big {
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.3;
    font-weight: 500;
    text-wrap: pretty;
  }
  .devices {
    display: grid;
    gap: 32px;
    justify-items: center;
    align-items: center;
  }
  .devices.mixed {
    grid-template-columns: auto minmax(0, 1fr);
  }
  .phones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
  }
  .phones :global(.demo) {
    width: 190px;
  }
  .devices:not(.mixed) .phones :global(.demo) {
    width: min(280px, 100%);
  }
  .devices > :global(.tablet) {
    width: min(100%, 720px);
  }
  @media (max-width: 1280px) {
    .devices.mixed {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .phones {
      flex-wrap: nowrap;
      gap: 12px;
    }
    .phones :global(.demo) {
      width: calc(50% - 6px);
    }
  }
  .context {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
  }
  .context li {
    padding: 20px;
    color: var(--soft);
  }
  .arch {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px;
  }
  .col {
    position: relative;
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .node {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: var(--surface);
  }
  .node span {
    font: 12px var(--font-mono);
    color: var(--muted);
  }
  .node.primary {
    padding-block: 26px;
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .node.primary span {
    color: inherit;
    opacity: 0.8;
  }
  .link {
    position: absolute;
    right: -36px;
    top: 50%;
    color: var(--accent);
  }
  .decisions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    list-style: none;
  }
  .decisions h3 {
    margin-top: 6px;
    font-size: 19px;
    font-weight: 600;
  }
  .decisions p {
    margin-top: 6px;
    color: var(--muted);
  }
  .results {
    display: grid;
    gap: 16px;
    list-style: none;
  }
  .results li {
    padding-left: 20px;
    border-left: 2px solid var(--accent);
    font-size: 20px;
    font-weight: 500;
  }
  .next {
    display: grid;
    gap: 6px;
    padding: 28px;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .next:hover {
    border-color: var(--accent);
  }
  .next-name {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  @media (max-width: 860px) {
    .block,
    .context,
    .decisions,
    .arch {
      grid-template-columns: minmax(0, 1fr);
    }
    .block {
      gap: 16px;
    }
    .link {
      position: static;
      justify-self: center;
      rotate: 90deg;
    }
  }
</style>
