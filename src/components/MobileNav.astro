---
// Bottom navigation for phones and small tablets, where the sidebar menu is hidden:
// large thumb-reachable targets for each section plus "Más", which opens the command palette.
import Icon from './Icon.astro'

const onHome = Astro.url.pathname === '/'
const items = [
  { id: 'sobre', label: 'Sobre mí', icon: 'user' },
  { id: 'proyectos', label: 'Proyectos', icon: 'grid' },
  { id: 'experiencia', label: 'Experiencia', icon: 'briefcase' },
  { id: 'stack', label: 'Stack', icon: 'layers' },
] as const
---

<nav class="mobile-nav" aria-label="Secciones">
  <span class="indicator" aria-hidden="true"></span>
  {
    items.map((it) => (
      <a href={`${onHome ? '' : '/'}#${it.id}`} data-mobile-section={it.id}>
        <Icon name={it.icon} size={20} />
        <span>{it.label}</span>
      </a>
    ))
  }
  <button type="button" data-open-palette aria-label="Más opciones: currículum, contacto y búsqueda">
    <Icon name="menu" size={20} />
    <span>Más</span>
  </button>
</nav>

<script>
  // Mark the section in view, like the sidebar does on desktop. The highlight is one pill that
  // slides to the active item, both when tapping an item and while scrolling between sections.
  const nav = document.querySelector<HTMLElement>('.mobile-nav')!
  const pill = nav.querySelector<HTMLElement>('.indicator')!
  const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-mobile-section]')]
  const targets = links.map((a) => document.getElementById(a.dataset.mobileSection!)).filter(Boolean) as HTMLElement[]
  let lockedUntil = 0

  function select(id: string | null) {
    const link = links.find((a) => a.dataset.mobileSection === id)
    links.forEach((a) => a.toggleAttribute('aria-current', a === link))
    if (!link) {
      pill.style.opacity = '0'
      return
    }
    pill.style.opacity = '1'
    pill.style.width = `${link.offsetWidth}px`
    pill.style.translate = `${link.offsetLeft}px 0`
  }

  if (targets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        // While the page scrolls to a tapped item, keep the pill on it instead of passing through
        // every section on the way.
        if (performance.now() < lockedUntil) return
        entries.forEach((e) => e.isIntersecting && select(e.target.id))
      },
      { rootMargin: '-40% 0px -55% 0px' },
    )
    targets.forEach((t) => io.observe(t))
    links.forEach((a) =>
      a.addEventListener('click', () => {
        lockedUntil = performance.now() + 1200
        select(a.dataset.mobileSection!)
      }),
    )
    addEventListener('scrollend', () => (lockedUntil = 0))
    addEventListener('resize', () => select(links.find((a) => a.hasAttribute('aria-current'))?.dataset.mobileSection ?? null))
  }
</script>

<style>
  .mobile-nav {
    display: none;
  }
  @media (max-width: 980px) {
    .mobile-nav {
      position: fixed;
      left: 50%;
      bottom: calc(12px + env(safe-area-inset-bottom));
      z-index: 50;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      width: min(100% - 24px, 520px);
      padding: 6px;
      border: 1px solid var(--line-2);
      border-radius: 22px;
      background: rgb(20 23 28 / 0.86);
      backdrop-filter: blur(16px);
      box-shadow: 0 18px 40px -12px rgb(0 0 0 / 0.8);
      translate: -50% 0;
    }
    a,
    button {
      display: grid;
      justify-items: center;
      gap: 3px;
      min-height: 54px;
      padding: 8px 2px 6px;
      border: 0;
      border-radius: 16px;
      background: none;
      color: var(--muted);
      font: 500 11px var(--font-sans);
      text-decoration: none;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      transition:
        color 0.2s,
        background-color 0.2s;
    }
    span {
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    a,
    button {
      position: relative;
      z-index: 1;
    }
    a[aria-current] {
      color: var(--accent);
    }
    .indicator {
      position: absolute;
      top: 6px;
      left: 0;
      height: calc(100% - 12px);
      border-radius: 16px;
      background-color: color-mix(in oklab, var(--accent) 14%, transparent);
      opacity: 0;
      pointer-events: none;
      transition:
        translate 0.45s cubic-bezier(0.3, 1.3, 0.5, 1),
        width 0.45s cubic-bezier(0.3, 1.3, 0.5, 1),
        opacity 0.3s;
    }
    @media (prefers-reduced-motion: reduce) {
      .indicator {
        transition: opacity 0.3s;
      }
    }
    a:active,
    button:active {
      background-color: var(--surface-2);
    }
  }
</style>
