---
import Icon from '../Icon.astro'

const roles = [
  {
    icon: 'code',
    title: 'Desarrollo',
    text: 'Fui el desarrollador principal del sistema de control de acceso y casino DGM (web y apps móviles); hoy lo monitoreo y le doy soporte diario.',
  },
  {
    icon: 'headset',
    title: 'Soporte senior',
    text: 'Atiendo y resuelvo los casos de soporte del sistema de acreditación SUCAL.',
  },
  {
    icon: 'mine',
    title: 'Terreno en faena',
    text: 'Mantengo sistemas de control de acceso y casino; he recorrido distintas divisiones de Codelco por todo Chile. Cuento con licencia de conducir clase B y experiencia manejando dentro de faenas mineras.',
  },
] as const
---

<section id="sobre" class="about">
  <p class="label">01 · Sobre mí</p>
  <h1 class="title">Desarrollador de Software &amp; Especialista en Sistemas Críticos</h1>
  <p class="place"><Icon name="pin" size={16} /> Basado en Calama, Chile.</p>
  <p class="lead">
    Construyo y mantengo soluciones de software que no pueden permitirse fallar. Me especializo en el desarrollo end-to-end
    (web y móvil) y en el soporte técnico de alto nivel para la gran minería.
  </p>
  <h2 class="sub">En Workmate (Soporte Senior &amp; Desarrollo):</h2>
  <ul class="roles glow-zone">
    {
      roles.map((r) => (
        <li class="card glow-card reveal">
          <Icon name={r.icon} size={26} />
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .about {
    display: grid;
    gap: 20px;
  }
  .lead {
    max-width: 840px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted);
  }
  .roles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 8px;
    list-style: none;
  }
  .roles li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px;
  }
  .roles :global(svg) {
    color: var(--accent);
  }
  .place {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 500 14px var(--font-mono);
    color: var(--accent);
  }
  .sub {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 600;
  }
  h3 {
    font-size: 19px;
    font-weight: 600;
  }
  .roles p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .roles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
